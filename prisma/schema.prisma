// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String            @unique
  emailVerified    DateTime?
  password         String
  image            String?
  role             String            @default("user") // user, admin
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  articles         Article[]
  sessions         Session[]
  trackedMaterials TrackedMaterial[]
  portfolioAssets  PortfolioAsset[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?  @db.Text
  content     String   @db.LongText
  aiSummary   String?  @db.LongText
  aiAnalysis  String?  @db.LongText
  imageUrl    String?
  sourceUrl   String?  @db.Text
  sourceName  String?
  category    String
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  materialEvents MaterialEvent[]

  @@index([authorId])
  @@index([slug])
  @@index([category])
}

model Video {
  id          String   @id @default(cuid())
  title       String
  url         String
  thumbnail   String?
  source      String   @default("manual") // manual, youtube_channel
  videoType   String   @default("video") // video, short
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// Batch-1 critical materials master record (43 materials).
// materialKey is the permanent, display-name-independent identifier used by
// watchlists, price history, events, alerts and URLs (e.g. "mat_gallium").
model RareEarthMaterial {
  id                     String                @id @default(cuid())
  materialKey            String?               @unique // permanent key, e.g. mat_gallium
  name                   String                @unique
  symbol                 String                @unique // chemical element symbol (e.g. U, not U3O8)
  category               String // visible card label (kept for now; see materialFamily/tags)
  // Backend taxonomy (P0-15): category mixes chemical family with end-use.
  // These fields carry the separated concepts without breaking the UI.
  materialFamily         String? // e.g. "Light Rare Earth", "Battery Metal"
  applicationTags        String?               @db.Text // JSON array of end-use tags
  strategicTags          String?               @db.Text // JSON array of strategic/criticality tags
  price                  Float? // legacy display price; benchmark layer is authoritative
  unit                   String?
  description            String?               @db.Text
  imageUrl               String?
  supply                 String?               @db.Text
  demand                 String?               @db.Text
  countries              String?               @db.Text // JSON string of countries (display layer)
  applications           String?               @db.Text // JSON string of applications (display layer)
  lastUpdated            DateTime              @default(now())
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  trackedBy              TrackedMaterial[]
  structuredApplications MaterialApplication[]
  countryRoles           MaterialCountryRole[]
  sourceLinks            MaterialSourceLink[]
  priceBenchmarks        PriceBenchmark[]
  eventLinks             MaterialEventLink[]
  riskPulses             MaterialRiskPulse[]
  riskState              MaterialRiskState?
  shockSimulations       ShockSimulation[]

  @@index([name])
  @@index([category])
  @@index([materialKey])
}

model Newsletter {
  id                  String   @id @default(cuid())
  email               String   @unique
  active              Boolean  @default(true)
  materialPreferences String?  @db.Text // JSON string of selected categories/topics
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([email])
}

model NewsletterReport {
  id          String   @id @default(cuid())
  subject     String
  reportType  String   @default("weekly") // daily, weekly
  htmlContent String   @db.LongText
  sentTo      String   @db.LongText // JSON array of emails
  sentCount   Int      @default(0)
  sentAt      DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([sentAt])
  @@index([reportType])
}

model TrackedMaterial {
  id         String            @id @default(cuid())
  userId     String
  materialId String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  material   RareEarthMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  // Last time the user viewed this material's page. Drives the
  // "Since You Last Checked" delta (C6). Never infer from newsletter delivery.
  lastSeenAt DateTime?

  @@unique([userId, materialId])
  @@index([userId])
  @@index([materialId])
}

// ---------------------------------------------------------------------------
// Critical Materials Intelligence — structured foundations (F2/F3/F4/F5)
// The legacy prose/JSON display fields on RareEarthMaterial remain the
// content layer; these models carry the machine-readable relationships used
// by OSINT relevance scoring, watchlists, newsletters and simulations.
// ---------------------------------------------------------------------------

// Source provenance (F4). One record per publisher/document so data years,
// URLs and verification dates are auditable instead of "USGS MCS 2025" prose.
model Source {
  id                String                @id @default(cuid())
  publisher         String // e.g. "USGS"
  document          String? // e.g. "Mineral Commodity Summaries 2026 — Gallium"
  url               String?               @db.Text
  publicationDate   DateTime?
  dataYear          Int? // the year the DATA describes (may differ from pub year)
  retrievedAt       DateTime              @default(now())
  verifiedAt        DateTime?
  notes             String?               @db.Text
  countryRoles      MaterialCountryRole[]
  materialLinks     MaterialSourceLink[]
  priceBenchmarks   PriceBenchmark[]
  priceObservations PriceObservation[]

  @@index([publisher])
}

// Structured application relationship (F2). Broad sectors must never qualify
// an article on their own; strength + qualifiesWithoutMention encode that.
model MaterialApplication {
  id                      String            @id @default(cuid())
  materialId              String
  material                RareEarthMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  name                    String // e.g. "Thulium-doped lasers"
  aliases                 String?           @db.Text // JSON array of alternative terms
  relationship            String            @default("direct_use") // direct_use, compound, downstream_technology, sector
  strength                String            @default("moderate") // direct, strong, moderate, weak
  qualifiesWithoutMention Boolean           @default(false) // can an article qualify without naming the material?
  notes                   String?           @db.Text
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([materialId])
  @@index([strength])
}

// Countries by supply-chain role (F3). Mining ≠ refining ≠ processing ≠
// component manufacturing ≠ consuming market; one country may hold many roles.
model MaterialCountryRole {
  id         String            @id @default(cuid())
  materialId String
  material   RareEarthMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  country    String
  stage      String // mining, refining, processing, manufacturing, consumption
  sharePct   Float? // share of that stage, e.g. 91 for 91%
  dataYear   Int?
  sourceId   String?
  source     Source?           @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([materialId, stage])
  @@index([country])
}

// Join table: which sources back which material (and optionally which field).
model MaterialSourceLink {
  id         String            @id @default(cuid())
  materialId String
  material   RareEarthMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  sourceId   String
  source     Source            @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  field      String? // e.g. "supply", "demand", "countries", "price"

  @@unique([materialId, sourceId, field])
  @@index([sourceId])
}

// Price benchmark definition (F5). A material can have several commercially
// relevant products/benchmarks (U3O8 $/lb, battery-grade Li2CO3 $/tonne, ...).
model PriceBenchmark {
  id              String             @id @default(cuid())
  materialId      String
  material        RareEarthMaterial  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  productForm     String // e.g. "U3O8", "lithium carbonate", "dysprosium oxide"
  grade           String? // e.g. "battery grade", "99.99% (4N)"
  benchmarkName   String? // e.g. "UxC U3O8 Spot Price"
  market          String? // geographic market, e.g. "China", "Europe", "Global"
  currency        String             @default("USD")
  unit            String // e.g. "lb", "tonne", "kg"
  updateFrequency String? // daily, weekly, monthly
  sourceId        String?
  source          Source?            @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  observations    PriceObservation[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([materialId])
}

// Timestamped price history (F5). Never overwrite — the material page queries
// the newest valid observation; history powers charts later.
model PriceObservation {
  id          String         @id @default(cuid())
  benchmarkId String
  benchmark   PriceBenchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)
  price       Float
  asOf        DateTime // the date the price is valid as of
  sourceId    String?
  source      Source?        @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())

  @@unique([benchmarkId, asOf])
  @@index([asOf])
}

model CommodityPrice {
  id                   String    @id @default(cuid())
  label                String
  symbol               String    @unique
  price                Float
  change               Float?
  previousClose        Float?
  type                 String
  marketStatus         String    @default("OPEN")
  lastTradingTimestamp DateTime?
  updatedAt            DateTime  @updatedAt
}

model MarketPriceHistory {
  id         String   @id @default(cuid())
  label      String
  symbol     String
  source     String
  interval   String
  open       Float
  high       Float
  low        Float
  close      Float
  volume     Float?
  recordedAt DateTime
  createdAt  DateTime @default(now())

  @@unique([symbol, interval, recordedAt])
  @@index([symbol, interval, recordedAt])
  @@index([recordedAt])
}

model MediaAsset {
  id        String   @id @default(cuid())
  kind      String
  filename  String
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

model SocialPost {
  id          String    @id @default(cuid())
  text        String    @db.Text
  imageUrl    String?   @db.Text
  imagePrompt String?   @db.Text
  status      String    @default("pending") // pending, approved, published, rejected
  platforms   String?   @db.Text // JSON array: ["linkedin","x","instagram"]
  publishedAt DateTime?
  scheduledAt DateTime?
  emailSent   Boolean   @default(false)
  retryCount  Int       @default(0)
  publishLog  String?   @db.Text // JSON log of publish results per platform
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([scheduledAt])
}

model VesselTrack {
  id         String   @id @default(cuid())
  mmsi       String
  shipName   String?
  latitude   Float
  longitude  Float
  heading    Float?
  speed      Float?
  source     String?
  recordedAt DateTime @default(now())

  @@index([mmsi, recordedAt])
  @@index([recordedAt])
}

model FlightTrack {
  id         String   @id @default(cuid())
  icao24     String
  callsign   String?
  latitude   Float
  longitude  Float
  altitude   Float?
  heading    Float?
  velocity   Float?
  source     String?
  recordedAt DateTime @default(now())

  @@index([icao24, recordedAt])
  @@index([recordedAt])
}

model PortfolioAsset {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  label     String
  quantity  Float
  buyPrice  Float
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Critical Materials Intelligence — the seven capability layer (C1–C7)
// One canonical MaterialEvent feeds relevance scoring (C1), early-warning
// (C2), implications (C3), risk pulse (C4), cross-material impact (C5),
// since-you-last-checked (C6) and shock simulation (C7).
// Severity and confidence are always separate fields.
// ---------------------------------------------------------------------------

// Canonical event record (C5): a multi-material event is stored ONCE and
// linked to every affected material via MaterialEventLink — never duplicated
// per material, so reports/newsletters can dedupe.
model MaterialEvent {
  id            String            @id @default(cuid())
  eventKey      String            @unique // dedupe hash of normalized title + day
  title         String
  summary       String?           @db.Text
  eventType     String            @default("other") // export_control, mine_outage, refinery_outage, project_delay, price_move, policy, demand_shift, capacity, sanctions, other
  stage         String? // mining, refining, processing, component, downstream
  occurredAt    DateTime          @default(now())
  sourceName    String?
  sourceUrl     String?           @db.Text
  articleId     String? // originating Article, when ingested from the news pipeline
  article       Article?          @relation(fields: [articleId], references: [id], onDelete: SetNull)
  severity      String            @default("moderate") // low, moderate, high, severe — magnitude IF true
  confidence    String            @default("medium") // low, medium, high — evidence quality, kept separate from severity
  countries     String?           @db.Text // JSON array of countries connected to the event
  companies     String?           @db.Text // JSON array of companies connected to the event
  status        String            @default("active") // active, expired, disproven
  expiresAt     DateTime? // after this the event stops contributing to risk scores
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  materialLinks MaterialEventLink[]
  implication   EventImplication?

  @@index([eventType])
  @@index([occurredAt])
  @@index([status])
}

// Event ↔ material relevance edge (C1). An event may affect materials
// directly, through a material family, through shared processing, or through
// common downstream applications (C5).
model MaterialEventLink {
  id               String            @id @default(cuid())
  eventId          String
  event            MaterialEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  materialId       String
  material         RareEarthMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  relevanceScore   Int // 0-100. 90-100 critical, 70-89 high, 50-69 moderate, <50 suppressed
  relevanceLevel   Int               @default(1) // 1 = direct material event, 2 = strong downstream implication, 3 = generic sector context
  relationshipType String            @default("direct") // direct, family, shared_processing, downstream_application
  whyRelevant      String?           @db.Text // one-sentence machine + human readable explanation
  severity         String? // per-material severity override (kept separate from confidence)
  confidence       String? // per-material confidence override
  createdAt        DateTime          @default(now())

  @@unique([eventId, materialId])
  @@index([materialId, relevanceScore])
  @@index([relevanceLevel])
}

// Structured "so what" for a qualifying event (C3). Every field must be
// traceable to the event, the material relationship and evidence; when
// evidence is insufficient the value is "uncertain", never invented prose.
model EventImplication {
  id                   String        @id @default(cuid())
  eventId              String        @unique
  event                MaterialEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  whatHappened         String        @db.Text // concise factual summary
  supplyImplication    String        @default("uncertain") // positive, negative, neutral, uncertain
  supplySeverity       String? // low, moderate, high
  demandImplication    String        @default("uncertain")
  demandSeverity       String?
  priceDirection       String        @default("unclear") // upward, downward, mixed, unclear
  affectedApplications String?       @db.Text // JSON array of application names/ids potentially affected
  timeHorizon          String        @default("uncertain") // immediate, 1-3_months, 6-12_months, uncertain
  watchTriggers        String?       @db.Text // JSON array: three concrete "what to watch next" triggers
  assessment           String?       @db.Text // GeoMoney assessment, tied to sources
  confidence           String        @default("low") // low, medium, high
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

// Append-only daily Risk Pulse history (C4). Scores are produced ONLY by the
// deterministic scoring rules over structured data/events — never by an LLM.
// contributions stores event-linked deltas, e.g. [{"label":"Export licensing","delta":5}].
model MaterialRiskPulse {
  id             String            @id @default(cuid())
  materialId     String
  material       RareEarthMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  asOf           DateTime // day the score is valid for (UTC midnight)
  score          Int // 0-100 composite
  supplyRisk     Int // 0-100 component: concentration + current disruptions
  policyRisk     Int // export controls, sanctions, tariffs, intervention
  demandPressure Int // application growth, procurement, demand shocks
  marketStress   Int // price movement, availability, dislocation
  supplyResponse Int // new capacity, restarts, substitution, recycling (higher = more response = lowers composite)
  contributions  String?           @db.Text // JSON array of {label, delta, eventId?}
  createdAt      DateTime          @default(now())

  @@unique([materialId, asOf])
  @@index([asOf])
}

// Current early-warning state per material (C2). Status changes accumulate
// signals over rolling windows rather than reacting to one headline.
model MaterialRiskState {
  id          String            @id @default(cuid())
  materialId  String            @unique
  material    RareEarthMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  status      String            @default("NORMAL") // NORMAL, WATCH, ELEVATED, CRITICAL
  statusSince DateTime          @default(now())
  drivers     String?           @db.Text // JSON array: top 3-5 drivers behind the current status
  delta24h    Int               @default(0) // pulse-score change over trailing 24h
  delta7d     Int               @default(0)
  delta30d    Int               @default(0)
  signals24h  Int               @default(0) // qualifying event count, trailing 24h
  signals7d   Int               @default(0)
  updatedAt   DateTime          @updatedAt
}

// Saved shock-propagation scenario (C7). Output is constrained: ranges and
// directional effects with per-component confidence, never false precision.
model ShockSimulation {
  id           String            @id @default(cuid())
  materialId   String
  material     RareEarthMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  userId       String? // nullable so anonymous simulations need no account
  shockType    String // export_restriction, mine_outage, refinery_outage, sanctions, logistics_disruption, demand_surge, new_capacity
  magnitudePct Int // 10, 25, 50, 75 or 100
  geography    String? // country/entity responsible for the shock
  durationDays Int               @default(90) // 30, 90, 365
  note         String?           @db.Text // optional analyst note
  result       String            @db.Text // JSON: stages, impacts, mitigation, pulseEffect, confidence, assumptions
  createdAt    DateTime          @default(now())

  @@index([materialId, createdAt])
}
